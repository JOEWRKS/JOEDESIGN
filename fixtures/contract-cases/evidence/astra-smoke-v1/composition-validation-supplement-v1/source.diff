+:root {
+  --color-page: #f4f6f5;
+  --color-surface: #fff;
+  --color-text: #263b36;
+  --color-muted: #56665f;
+  --color-line: #bac7c1;
+  --color-accent: #245b49;
+  --color-hover: #edf4f0;
+
+  --space-group-1: 48px;
+  --space-group-2: 24px;
+  --space-group-3: 16px;
+  --space-tight: 8px;
+  --space-micro: 4px;
+
+  --type-title: 48px;
+  --type-price: 40px;
+  --type-kit: 24px;
+  --type-result: 20px;
+  --type-body: 16px;
+  --type-label: 14px;
+}
+
 * { box-sizing: border-box; }
-body { margin: 0; background: #f4f6f5; color: #263b36; font: 16px/1.5 Arial, sans-serif; }
-main { max-width: 1120px; margin: 0 auto; padding: 48px 32px; }
-.page-heading { margin-bottom: 32px; }
-.brand { margin: 0 0 12px; color: #245b49; font-size: 18px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
-h1 { margin: 0 0 12px; font-size: 28px; line-height: 1.2; font-weight: 500; }
-.intro { margin: 0 0 12px; }
-.hire-note { margin: 0; font-size: 16px; font-weight: 700; }
-.options { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 20px; }
-.option { display: flex; flex-direction: column; padding: 20px; background: #fff; border: 1px solid #bac7c1; border-radius: 12px; }
-.option h2 { margin: 0 0 12px; font-size: 18px; font-weight: 500; }
-.price { margin: 0 0 20px; font-size: 18px; }
-.option h3 { margin: 0 0 8px; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; }
-ul { padding-left: 20px; margin: 0 0 20px; font-size: 14px; line-height: 1.6; }
-.availability { margin: auto 0 20px; font-size: 14px; }
-.availability span { display: block; font-weight: 700; }
-button { min-height: 44px; width: 100%; padding: 10px 8px; border: 1px solid #466b5c; border-radius: 6px; background: #fff; color: #254b3c; font: 14px/1.4 Arial, sans-serif; cursor: pointer; }
-button:hover { background: #edf4f0; }
-button:focus-visible { outline: 3px solid #245b49; outline-offset: 3px; }
-button[aria-pressed="true"] { background: #245b49; color: #fff; }
-.option.is-selected { border-color: #245b49; }
-.selection { margin-top: 28px; }
-.selection h2 { margin: 0 0 8px; font-size: 18px; font-weight: 500; }
-output { display: block; font-size: 14px; }
-@media (max-width: 720px) {
-  main { padding: 24px 20px; }
-  .options { grid-template-columns: 1fr; gap: 16px; }
+
+body {
+  margin: 0;
+  background: var(--color-page);
+  color: var(--color-text);
+  font: var(--type-body)/1.5 Arial, sans-serif;
+}
+
+main {
+  max-width: 1200px;
+  margin: 0 auto;
+  padding: var(--space-group-1);
+}
+
+.page-heading { margin-bottom: var(--space-group-1); }
+
+.brand {
+  margin: 0 0 var(--space-group-2);
+  color: var(--color-accent);
+  font-size: var(--type-label);
+  font-weight: 700;
+  letter-spacing: .08em;
+  text-transform: uppercase;
+}
+
+h1 {
+  margin: 0 0 var(--space-tight);
+  font-size: var(--type-title);
+  line-height: 1.1;
+  font-weight: 700;
+  letter-spacing: -.035em;
+  text-wrap: balance;
+}
+
+.intro { max-width: 56ch; margin: 0; color: var(--color-muted); }
+
+.hire-note {
+  margin: var(--space-group-2) 0 0;
+  color: var(--color-muted);
+  font-size: var(--type-label);
+}
+
+.options {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: var(--space-group-2);
+}
+
+/* Each kit owns its summary, equipment and availability/action group. */
+.option {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-group-2);
+  padding: var(--space-group-2);
+  background: var(--color-surface);
+  border: 1px solid var(--color-line);
+  border-radius: 8px;
+}
+
+.option h2 {
+  margin: 0;
+  font-size: var(--type-kit);
+  line-height: 1.25;
+  font-weight: 700;
+  letter-spacing: -.02em;
+}
+
+.price {
+  margin: var(--space-tight) 0 0;
+  font-size: var(--type-price);
+  line-height: 1.2;
+  font-variant-numeric: tabular-nums;
+  letter-spacing: -.025em;
+}
+
+.price span {
+  color: var(--color-muted);
+  font-size: var(--type-label);
+  letter-spacing: normal;
+}
+
+.option h3 {
+  margin: 0 0 var(--space-tight);
+  color: var(--color-muted);
+  font-size: var(--type-label);
+  line-height: 1.5;
+  font-weight: 400;
+}
+
+.equipment ul {
+  margin: 0;
+  padding-left: var(--space-group-3);
+  font-size: var(--type-body);
+}
+
+.equipment li + li { margin-top: var(--space-micro); }
+.equipment li::marker { color: var(--color-muted); }
+
+.kit-choice {
+  display: grid;
+  gap: var(--space-group-3);
+  margin-top: auto;
+}
+
+.availability { margin: 0; }
+
+.availability span {
+  display: block;
+  margin-bottom: var(--space-micro);
+  color: var(--color-muted);
+  font-size: var(--type-label);
+}
+
+button {
+  width: 100%;
+  min-height: 48px;
+  padding: var(--space-tight);
+  border: 1px solid var(--color-accent);
+  border-radius: 4px;
+  background: var(--color-surface);
+  color: var(--color-accent);
+  font: 700 var(--type-label)/1.5 Arial, sans-serif;
+  cursor: pointer;
+}
+
+button:hover { background: var(--color-hover); }
+button:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }
+button[aria-pressed="true"] { background: var(--color-accent); color: var(--color-surface); }
+.option.is-selected { border-color: var(--color-accent); box-shadow: inset 0 0 0 1px var(--color-accent); }
+
+.selection {
+  margin-top: var(--space-group-1);
+  padding-top: var(--space-group-2);
+  border-top: 1px solid var(--color-line);
+}
+
+.selection h2 {
+  margin: 0 0 var(--space-tight);
+  font-size: var(--type-result);
+  line-height: 1.3;
+  font-weight: 700;
+}
+
+output { display: block; max-width: 65ch; color: var(--color-muted); }
+
+@media (max-width: 1000px) {
+  :root { --type-title: 32px; --type-price: 32px; }
+  main { max-width: 600px; padding: var(--space-group-2); }
+  .options { grid-template-columns: 1fr; }
+}
+
+@media (forced-colors: active) {
+  button[aria-pressed="true"] { outline: 2px solid Highlight; outline-offset: -5px; }
 }
