[Bash] cd "<ROOT>" && cat > .work/px.mjs <<'EOF'
import fs from 'node:fs'; import zlib from 'node:zlib';
function dec(f){const b=fs.readFileSync(f);let o=8,w,h,ct,idat=[];while(o<b.length){const len=b.readUInt32BE(o),t=b.toString('ascii',o+4,o+8),d=b.subarray(o+8,o+8+len);if(t==='IHDR'){w=d.readUInt32BE(0);h=d.readUInt32BE(4);ct=d[9];}if(t==='IDAT')idat.push(d);o+=12+len;}
const bpp=ct===6?4:3,raw=zlib.inflateSync(Buffer.concat(idat)),st=w*bpp,px=Buffer.alloc(h*st);
for(let y=0;y<h;y++){const f=raw[y*(st+1)],s=raw.subarray(y*(st+1)+1,(y+1)*(st+1));for(let x=0;x<st;x++){const a=x>=bpp?px[y*st+x-bpp]:0,u=y>0?px[(y-1)*st+x]:0,c=(x>=bpp&&y>0)?px[(y-1)*st+x-bpp]:0;let v=s[x];if(f===1)v+=a;else if(f===2)v+=u;else if(f===3)v+=(a+u)>>1;else if(f===4){const p=a+u-c,pa=Math.abs(p-a),pb=Math.abs(p-u),pc=Math.abs(p-c);v+=(pa<=pb&&pa<=pc)?a:(pb<=pc?u:c);}px[y*st+x]=v&255;}}
return {w,h,get:(x,y)=>{const i=y*st+x*bpp;return [px[i],px[i+1],px[i+2]];}};}
const [file,x0,x1,y0,y1]=process.argv.slice(2);const im=dec(file);const nw=([r,g,b])=>!(r>250&&g>250&&b>250);
// rows with non-white in column range
const rows=[];for(let y=+y0;y<=+y1;y++){let n=0;for(let x=+x0;x<=+x1;x++)if(nw(im.get(x,y)))n++;rows.push(y+':'+n);}
console.log('size',im.w,im.h);console.log(rows.join(' '));
// columns with non-white in row range (for right edge)
let maxX=-1,minX=1e9;for(let y=+y0;y<=+y1;y++)for(let x=+x0;x<=+x1;x++)if(nw(im.get(x,y))){maxX=Math.max(maxX,x);minX=Math.min(minX,x);}
console.log('ink x range',minX,maxX);
EOF
