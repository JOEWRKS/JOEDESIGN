import { execFileSync } from 'node:child_process';
const sizes = [[320,700],[375,700],[768,1024],[1280,800]];
const states = { empty: '', c199: '가'.repeat(199), c200: '가'.repeat(200) };
const evalExpr = `(()=>{const t=document.getElementById('body').getBoundingClientRect();const c=document.getElementById('body-count').getBoundingClientRect();const d=document.documentElement;return {text:document.getElementById('body-count').textContent,len:document.getElementById('body').value.length,gap:+(c.top-t.bottom).toFixed(2),rightDiff:+(c.right-t.right).toFixed(2),taBottom:t.bottom,taRight:t.right,cTop:c.top,cRight:c.right,cLeft:c.left,cBottom:c.bottom,sw:d.scrollWidth,cw:d.clientWidth,iw:innerWidth,bodySW:document.body.scrollWidth,space1:getComputedStyle(d).getPropertyValue('--space-1').trim(),fieldGap:getComputedStyle(document.querySelector('.field')).rowGap}})()`;
const out = [];
for (const [w,h] of sizes) for (const [s,v] of Object.entries(states)) {
  const before = `const b=document.getElementById('body');b.value=${JSON.stringify(v)};b.dispatchEvent(new Event('input',{bubbles:true}));`;
  const r = execFileSync('node', ['tools/measure.mjs','--page','src/index.html','--width',String(w),'--height',String(h),'--inject','src/style.css','--before',before,'--eval',evalExpr,'--screenshot',`.work/shot-${w}-${s}.png`], {encoding:'utf8'});
  const j = JSON.parse(r); out.push({w,s,...j.value,linked:j.linkedCss[0].loaded});
}
console.log(JSON.stringify(out,null,0).replace(/\},\{/g,'},\n{'));
EOF
