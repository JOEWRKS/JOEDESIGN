[Bash] cd "<ROOT>" && cat > .work/png.mjs <<'EOF'
import fs from 'node:fs'; import zlib from 'node:zlib';
export function decode(file){const b=fs.readFileSync(file);let p=8,w,h,ct,idat=[];while(p<b.length){const len=b.readUInt32BE(p),type=b.toString('ascii',p+4,p+8),d=b.subarray(p+8,p+8+len);if(type==='IHDR'){w=d.readUInt32BE(0);h=d.readUInt32BE(4);ct=d[9];if(d[8]!==8)throw Error('depth');}if(type==='IDAT')idat.push(d);p+=12+len;}
const bpp=ct===6?4:ct===2?3:(()=>{throw Error('ct '+ct)})();const raw=zlib.inflateSync(Buffer.concat(idat));const st=w*bpp;const out=Buffer.alloc(h*st);
for(let y=0;y<h;y++){const f=raw[y*(st+1)],src=raw.subarray(y*(st+1)+1,(y+1)*(st+1));for(let x=0;x<st;x++){const a=x>=bpp?out[y*st+x-bpp]:0,up=y?out[(y-1)*st+x]:0,c=(x>=bpp&&y)?out[(y-1)*st+x-bpp]:0;let v=src[x];if(f===1)v+=a;else if(f===2)v+=up;else if(f===3)v+=(a+up)>>1;else if(f===4){const pp=a+up-c,pa=Math.abs(pp-a),pb=Math.abs(pp-up),pc=Math.abs(pp-c);v+=(pa<=pb&&pa<=pc)?a:(pb<=pc?up:c);}out[y*st+x]=v&255;}}
return {w,h,px:(x,y)=>{const i=y*st+x*bpp;return [out[i],out[i+1],out[i+2]];}};}
EOF
cat > .work/scan.mjs <<'EOF'
import {decode} from './png.mjs'; import fs from 'node:fs';
const res=JSON.parse(fs.readFileSync('.work/results.json','utf8'));
for(const r of res){const img=decode(`.work/shot-${r.w}-${r.state}.png`);const nonbg=(x,y)=>{const [a,b,c]=img.px(x,y);return a<245||b<245||c<245;};
 // textarea border bottom: scan column at textarea center-ish (left side of field) upward from taBottom
 const tb=Math.round(r.taBottom); // border last row = tb-1
 let borderRow=-1; const colX=Math.round(r.cLeft-20>0?r.cLeft-20:r.cLeft); for(let y=tb+2;y>tb-4;y--){ if(nonbg(colX,y)){borderRow=y;break;} }
 // counter ink bounds within its box region extended
 let top=1e9,bot=-1,right=-1,left=1e9; for(let y=Math.floor(r.cTop)-2;y<Math.ceil(r.cTop+r.cH)+2;y++)for(let x=Math.floor(r.cLeft)-2;x<Math.min(img.w,Math.ceil(r.cRight)+3);x++){ if(y<=borderRow+0) continue; if(nonbg(x,y)){top=Math.min(top,y);bot=Math.max(bot,y);right=Math.max(right,x);left=Math.min(left,x);} }
 // textarea right border ink: scan row in middle of textarea
 const midY=Math.round(r.taBottom-30); let taRightInk=-1; for(let x=img.w-1;x>=0;x--){ if(nonbg(x,midY)){taRightInk=x;break;} }
 // overflow visual: any non-bg at last column?
 let edge=0; for(let y=0;y<img.h;y++) if(nonbg(img.w-1,y)) edge++;
 console.log(r.w,r.state,'borderLastRow',borderRow,'inkTop',top,'visibleGap',top-borderRow-1,'inkRight',right,'taRightInk',taRightInk,'rightDiffInk',right-taRightInk,'lastColNonBg',edge);
}
EOF
