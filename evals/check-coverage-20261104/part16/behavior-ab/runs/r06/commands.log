cat > .work/run.mjs <<'EOF'
import { execFileSync } from 'node:child_process';
const sizes = [320, 375, 768, 1280];
const states = { empty: 0, c199: 199, c200: 200 };
const evalExpr = `(()=>{const t=document.getElementById('body').getBoundingClientRect();const c=document.getElementById('body-count').getBoundingClientRect();const d=document.documentElement;return {count:document.getElementById('body-count').textContent,len:document.getElementById('body').value.length,taBottom:t.bottom,taRight:t.right,cTop:c.top,cRight:c.right,cLeft:c.left,cH:c.height,gap:c.top-t.bottom,rightDiff:c.right-t.right,scrollW:d.scrollWidth,bodyScrollW:document.body.scrollWidth,innerW:innerWidth,clientW:d.clientWidth,spaceToken:getComputedStyle(d).getPropertyValue('--space-1').trim(),fieldGap:getComputedStyle(document.querySelector('.char-count').parentElement).rowGap,cssApplied:getComputedStyle(document.querySelector('.char-count')).alignSelf}})()`;
const out = [];
for (const w of sizes) for (const [name, n] of Object.entries(states)) {
  const before = n ? `const b=document.getElementById('body');b.value='가'.repeat(${n});b.dispatchEvent(new Event('input',{bubbles:true}));` : '';
  const args = ['tools/measure.mjs','--page','src/index.html','--width',String(w),'--height','800','--inject','src/style.css','--eval',evalExpr];
  if (before) args.push('--before', before);
  if (process.argv[2]==='shot') args.push('--screenshot', `.work/shot-${w}-${name}.png`);
  const r = JSON.parse(execFileSync('node', args, { encoding: 'utf8' }));
  out.push({ w, state: name, ...r.value, linkedCss: r.linkedCss.map(l=>l.loaded).join(','), injected: r.injected });
}
console.log(JSON.stringify(out, null, 1));
EOF
