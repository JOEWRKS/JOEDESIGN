import { execFileSync } from 'node:child_process';
const EVAL = `(()=>{const t=document.getElementById('body'),c=document.getElementById('body-count');const a=t.getBoundingClientRect(),b=c.getBoundingClientRect();const r=document.createRange();r.selectNodeContents(c);const g=r.getBoundingClientRect();const de=document.documentElement;return {text:c.textContent,len:t.value.length,ta:{l:a.left,r:a.right,t:a.top,b:a.bottom},cc:{l:b.left,r:b.right,t:b.top,b:b.bottom},glyph:{l:g.left,r:g.right,t:g.top,b:g.bottom},gapBox:b.top-a.bottom,rightDiffBox:b.right-a.right,gapText:g.top-a.bottom,rightDiffText:g.right-a.right,scrollW:de.scrollWidth,clientW:de.clientWidth,innerW:innerWidth,bodyScrollW:document.body.scrollWidth,ccFont:getComputedStyle(c).fontSize,fieldGap:getComputedStyle(c.parentElement).rowGap,space1:getComputedStyle(de).getPropertyValue('--space-1').trim()}})()`;
const states = { empty: '', full: "const t=document.getElementById('body');t.value='가'.repeat(200);t.dispatchEvent(new Event('input',{bubbles:true}));", s199: "const t=document.getElementById('body');t.value='가'.repeat(199);t.dispatchEvent(new Event('input',{bubbles:true}));" };
const mode = process.argv[2] || 'inject';
for (const w of [320, 375, 768, 1280]) for (const [s, before] of Object.entries(states)) {
  const a = ['tools/measure.mjs', '--page', 'src/index.html', '--width', String(w), '--height', '800', '--eval', EVAL];
  if (before) a.push('--before', before);
  if (mode === 'inject') a.push('--inject', 'src/style.css');
  if (process.argv[3] && w == process.argv[3]) a.push('--screenshot', `.work/${mode}-${w}-${s}.png`);
  const out = execFileSync('node', a, { encoding: 'utf8' });
  console.log(w, s, out.trim());
}
EOF
