import fs from 'node:fs'; import zlib from 'node:zlib';
const f = process.argv[2]; const buf = fs.readFileSync(f);
let p = 8, w, h, ct, idat = [];
while (p < buf.length) { const len = buf.readUInt32BE(p); const type = buf.toString('ascii', p+4, p+8); const d = buf.subarray(p+8, p+8+len);
  if (type==='IHDR'){w=d.readUInt32BE(0);h=d.readUInt32BE(4);ct=d[9];} if(type==='IDAT')idat.push(d); p+=12+len; }
const bpp = ct===6?4:3; const raw = zlib.inflateSync(Buffer.concat(idat)); const stride=w*bpp; const px=Buffer.alloc(h*stride);
for(let y=0;y<h;y++){const ft=raw[y*(stride+1)];for(let x=0;x<stride;x++){const v=raw[y*(stride+1)+1+x];const a=x>=bpp?px[y*stride+x-bpp]:0;const b=y?px[(y-1)*stride+x]:0;const c=(x>=bpp&&y)?px[(y-1)*stride+x-bpp]:0;let r;
 switch(ft){case 0:r=v;break;case 1:r=v+a;break;case 2:r=v+b;break;case 3:r=v+((a+b)>>1);break;case 4:{const pp=a+b-c,pa=Math.abs(pp-a),pb=Math.abs(pp-b),pc=Math.abs(pp-c);r=v+(pa<=pb&&pa<=pc?a:pb<=pc?b:c);}}px[y*stride+x]=r&255;}}
const at=(x,y)=>{const i=y*stride+x*bpp;return [px[i],px[i+1],px[i+2]];};
const nonwhite=(x,y)=>{const [r,g,b]=at(x,y);return r<245||g<245||b<245;};
// region args: x0 x1 y0 y1
const [x0,x1,y0,y1]=process.argv.slice(3).map(Number);
let minX=1e9,maxX=-1,minY=1e9,maxY=-1;
for(let y=y0;y<y1;y++)for(let x=x0;x<x1;x++)if(nonwhite(x,y)){minX=Math.min(minX,x);maxX=Math.max(maxX,x);minY=Math.min(minY,y);maxY=Math.max(maxY,y);}
// rightmost column with nonwhite across whole image (overflow check)
let pageMaxX=-1; for(let y=0;y<h;y++)for(let x=0;x<w;x++)if(nonwhite(x,y))pageMaxX=Math.max(pageMaxX,x);
// textarea bottom border: scan column x=(x0) upward? report last nonwhite row of border at column mid
const col=Number(process.argv[7]); let taBottom=-1; if(col>=0){for(let y=0;y<y0;y++)if(nonwhite(col,y))taBottom=y;}
let taRight=-1; const row=Number(process.argv[8]); if(row>=0){for(let x=0;x<w;x++)if(nonwhite(x,row))taRight=x;}
console.log(JSON.stringify({w,h,ink:{minX,maxX,minY,maxY},pageMaxX,taBottomRowAtCol:taBottom,taRightColAtRow:taRight}));
EOF
