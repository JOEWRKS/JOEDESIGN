import fs from 'node:fs'; import zlib from 'node:zlib';
function decode(f){const b=fs.readFileSync(f);let p=8,w,h,ct,idat=[];while(p<b.length){const len=b.readUInt32BE(p),type=b.toString('ascii',p+4,p+8),d=b.subarray(p+8,p+8+len);if(type==='IHDR'){w=d.readUInt32BE(0);h=d.readUInt32BE(4);ct=d[9];}if(type==='IDAT')idat.push(d);p+=12+len;}
const bpp=ct===6?4:3,raw=zlib.inflateSync(Buffer.concat(idat)),st=w*bpp,px=Buffer.alloc(h*st);
for(let y=0;y<h;y++){const ft=raw[y*(st+1)],src=raw.subarray(y*(st+1)+1,(y+1)*(st+1));for(let x=0;x<st;x++){const a=x>=bpp?px[y*st+x-bpp]:0,up=y?px[(y-1)*st+x]:0,c=(x>=bpp&&y)?px[(y-1)*st+x-bpp]:0;let v=src[x];if(ft===1)v+=a;else if(ft===2)v+=up;else if(ft===3)v+=(a+up)>>1;else if(ft===4){const pp=a+up-c,pa=Math.abs(pp-a),pb=Math.abs(pp-up),pc=Math.abs(pp-c);v+=(pa<=pb&&pa<=pc)?a:(pb<=pc?up:c);}px[y*st+x]=v&255;}}
return {w,h,get:(x,y)=>{const i=y*st+x*bpp;return [px[i],px[i+1],px[i+2]];}};}
const res=JSON.parse(fs.readFileSync('.work/results.json','utf8'));
for(const r of res){const im=decode(`.work/shot-${r.w}-${r.s}.png`);const dark=(x,y)=>{const [R,G,B]=im.get(x,y);return R+G+B<600;};
// textarea visible bottom border: last dark row scanning down at column taRight-20 from cTop-10
const xc=Math.round(r.taRight)-20;let border=-1;for(let y=Math.round(r.taBottom)-6;y<Math.round(r.taBottom)+2;y++)if(dark(xc,y))border=y;
// ink of count below border, within x [taRight-80, taRight+5]
let top=-1,right=-1,bottom=-1;for(let y=border+1;y<border+30;y++)for(let x=Math.round(r.taRight)-80;x<Math.min(im.w,Math.round(r.taRight)+5);x++)if(dark(x,y)){if(top<0)top=y;bottom=y;if(x>right)right=x;}
// textarea right visible border column at row border-20
let tright=-1;for(let x=Math.round(r.taRight)-4;x<Math.min(im.w,Math.round(r.taRight)+3);x++)if(dark(x,border-20))tright=x;
console.log(r.w,r.s,'borderRow',border,'inkTop',top,'visibleGap',top-border-1,'inkRight',right,'taRightCol',tright,'rightInset',tright-right,'inkBottom',bottom);}
EOF
