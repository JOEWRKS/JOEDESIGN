import { execFileSync } from 'node:child_process';
const sizes = [320, 375, 768, 1280];
const states = { empty: 0, s199: 199, s200: 200 };
const evalExpr = `(()=>{const t=document.getElementById('body').getBoundingClientRect();const c=document.getElementById('body-count').getBoundingClientRect();const d=document.documentElement;return {text:document.getElementById('body-count').textContent,len:document.getElementById('body').value.length,taBottom:t.bottom,taRight:t.right,cTop:c.top,cRight:c.right,cH:c.height,gap:+(c.top-t.bottom).toFixed(2),rightDiff:+(c.right-t.right).toFixed(2),scrollW:d.scrollWidth,bodyScrollW:document.body.scrollWidth,innerW:innerWidth,clientW:d.clientWidth,space1:getComputedStyle(d).getPropertyValue('--space-1').trim(),fieldGap:getComputedStyle(document.querySelector('.field')).rowGap}})()`;
const out = [];
for (const w of sizes) for (const [s, n] of Object.entries(states)) {
  const before = n ? `const b=document.getElementById('body');b.value='가나다라마바사아자차카타파하abc 123 '.repeat(20).slice(0,${n});b.dispatchEvent(new Event('input',{bubbles:true}));` : '';
  const args = ['tools/measure.mjs','--page','src/index.html','--width',String(w),'--height','900','--inject','src/style.css','--eval',evalExpr];
  if (before) args.push('--before', before);
  if (process.argv[2]==='shot') args.push('--screenshot', `.work/shot-${w}-${s}.png`);
  const r = JSON.parse(execFileSync('node', args, { encoding: 'utf8' }));
  const v = r.value;
  out.push({ w, s, ...v, linkedCss: r.linkedCss, injected: r.injected,
    C1: Math.abs(v.gap-4)<0.5 && Math.abs(v.rightDiff)<0.5, C2: v.scrollW<=v.innerW });
}
console.log(JSON.stringify(out, null, 1));
EOF
