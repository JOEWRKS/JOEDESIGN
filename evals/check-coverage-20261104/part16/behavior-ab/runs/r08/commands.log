#!/bin/sh
cd "$(dirname "$0")/.."
EVAL='(()=>{const t=document.getElementById("body").getBoundingClientRect();const c=document.getElementById("body-count").getBoundingClientRect();const d=document.documentElement;return {text:document.getElementById("body-count").textContent,len:document.getElementById("body").value.length,taBottom:t.bottom,cTop:c.top,gap:+(c.top-t.bottom).toFixed(2),taRight:t.right,cRight:c.right,rightDiff:+(t.right-c.right).toFixed(2),cH:c.height,scrollW:d.scrollWidth,clientW:d.clientWidth,innerW:innerWidth,bodyScrollW:document.body.scrollWidth,ok:{c1:Math.abs(c.top-t.bottom-4)<0.5&&Math.abs(t.right-c.right)<0.5,c2:d.scrollWidth<=innerWidth&&document.body.scrollWidth<=innerWidth}}})()'
for w in 320 375 768 1280; do
  for s in empty 199 200; do
    case $s in
      empty) B='';;
      199) B='const b=document.getElementById("body");b.value="가".repeat(199);b.dispatchEvent(new Event("input",{bubbles:true}));';;
      200) B='const b=document.getElementById("body");b.value="가".repeat(200);b.dispatchEvent(new Event("input",{bubbles:true}));';;
    esac
    printf '%s %s ' $w $s
    node tools/measure.mjs --page src/index.html --width $w --height 800 --inject src/style.css --before "$B" --eval "$EVAL" --screenshot .work/shot-$w-$s.png
  done
done
EOF
