// Pixel spot check: textarea bottom border row / right border col vs count glyph ink.
import fs from 'node:fs'; import zlib from 'node:zlib';
function png(file){const b=fs.readFileSync(file);let p=8,w,h,ct,idat=[];while(p<b.length){const len=b.readUInt32BE(p),type=b.toString('ascii',p+4,p+8),d=b.subarray(p+8,p+8+len);if(type==='IHDR'){w=d.readUInt32BE(0);h=d.readUInt32BE(4);ct=d[9];}if(type==='IDAT')idat.push(d);p+=12+len;}
const bpp=ct===6?4:3,raw=zlib.inflateSync(Buffer.concat(idat)),st=w*bpp,out=Buffer.alloc(h*st);
for(let y=0;y<h;y++){const f=raw[y*(st+1)],src=raw.subarray(y*(st+1)+1,(y+1)*(st+1));for(let x=0;x<st;x++){const a=x>=bpp?out[y*st+x-bpp]:0,u=y?out[(y-1)*st+x]:0,c=(x>=bpp&&y)?out[(y-1)*st+x-bpp]:0;let v=src[x];if(f===1)v+=a;else if(f===2)v+=u;else if(f===3)v+=(a+u)>>1;else if(f===4){const pp=a+u-c,pa=Math.abs(pp-a),pb=Math.abs(pp-u),pc=Math.abs(pp-c);v+=(pa<=pb&&pa<=pc)?a:(pb<=pc?u:c);}out[y*st+x]=v&255;}}
return {w,h,px:(x,y)=>{const i=y*st+x*bpp;return [out[i],out[i+1],out[i+2]];}};}
const [file, taRight, taBottom] = [process.argv[2], +process.argv[3], +process.argv[4]];
const im = png(file); const dark = (x,y)=>{const [r,g,b]=im.px(x,y);return r+g+b < 600;};
// textarea bottom border: scan up from taBottom at x = taRight-40 for last non-white row
let border=-1; for(let y=taBottom+2;y>taBottom-6;y--){ if(dark(taRight-40,y)){border=y;break;} }
// right border column at y = taBottom-30
let rb=-1; for(let x=taRight+2;x>taRight-6;x--){ if(dark(x,taBottom-30)){rb=x;break;} }
// count ink box: region y in [taBottom, taBottom+25], x in [taRight-80, taRight+3]
let top=1e9,bot=-1,left=1e9,right=-1; for(let y=taBottom;y<taBottom+26;y++)for(let x=taRight-80;x<taRight+3;x++) if(dark(x,y)){top=Math.min(top,y);bot=Math.max(bot,y);left=Math.min(left,x);right=Math.max(right,x);}
console.log(JSON.stringify({file, borderBottomRow:border, rightBorderCol:rb, inkTop:top, inkBottom:bot, inkLeft:left, inkRight:right, visibleGapPx: top-border-1, rightEdgeDiffPx: right-rb}));
EOF
