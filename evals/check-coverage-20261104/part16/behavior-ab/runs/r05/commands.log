// Runs tools/measure.mjs for C1/C2 over sizes x states, with and without --inject.
import { execFileSync } from 'node:child_process';
const sizes = [320, 375, 768, 1280];
const states = { empty: '', c199: '가'.repeat(199), c200: '가'.repeat(200) };
const evalExpr = `(() => {
  const ta = document.getElementById('body').getBoundingClientRect();
  const cc = document.getElementById('body-count');
  const c = cc.getBoundingClientRect();
  const r = document.createRange(); r.selectNodeContents(cc); const t = r.getBoundingClientRect();
  const de = document.documentElement;
  return { text: cc.textContent, taBottom: ta.bottom, taRight: ta.right, ccTop: c.top, ccRight: c.right, ccH: c.height,
    gap: +(c.top - ta.bottom).toFixed(2), rightDiff: +(c.right - ta.right).toFixed(2), textRight: +(t.right).toFixed(2),
    scrollW: de.scrollWidth, clientW: de.clientWidth, innerW: innerWidth, bodyScrollW: document.body.scrollWidth,
    ccColor: getComputedStyle(cc).color, ccAlign: getComputedStyle(cc).alignSelf };
})()`;
const out = [];
const mode = process.argv[2] || 'inject';
for (const w of sizes) for (const [s, v] of Object.entries(states)) {
  const args = ['tools/measure.mjs', '--page', 'src/index.html', '--width', String(w), '--height', '800',
    '--before', `const b=document.getElementById('body'); b.value=${JSON.stringify(v)}; b.dispatchEvent(new Event('input'));`,
    '--eval', evalExpr];
  if (mode === 'inject') args.push('--inject', 'src/style.css');
  if (process.argv[3] === 'shot') args.push('--screenshot', `.work/${mode}-${w}-${s}.png`);
  const r = JSON.parse(execFileSync('node', args, { encoding: 'utf8' }));
  out.push({ w, s, ...r.value, linkedCss: r.linkedCss.map(l => l.loaded).join(','), injected: r.injected });
}
console.log(JSON.stringify(out, null, 0).replace(/},{/g, '},\n{'));
EOF
