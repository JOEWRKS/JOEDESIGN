import { execFileSync } from 'node:child_process';
const sizes = [320, 375, 768, 1280];
const states = {
  empty: "",
  c199: "b.value='가'.repeat(199);b.dispatchEvent(new Event('input',{bubbles:true}));",
  c200: "b.value='가'.repeat(200);b.dispatchEvent(new Event('input',{bubbles:true}));",
};
const evalExpr = `(()=>{const t=document.getElementById('body').getBoundingClientRect();const c=document.getElementById('body-count').getBoundingClientRect();return {text:document.getElementById('body-count').textContent,len:document.getElementById('body').value.length,gap:+(c.top-t.bottom).toFixed(2),rightDiff:+(c.right-t.right).toFixed(2),taRight:t.right,taBottom:t.bottom,ccTop:c.top,ccRight:c.right,sw:document.documentElement.scrollWidth,bsw:document.body.scrollWidth,iw:innerWidth,cw:document.documentElement.clientWidth,space1:getComputedStyle(document.documentElement).getPropertyValue('--space-1').trim()}})()`;
const out = [];
for (const w of sizes) for (const [s, js] of Object.entries(states)) {
  const args = ['tools/measure.mjs','--page','src/index.html','--width',String(w),'--height','800','--inject','src/style.css','--eval',evalExpr];
  if (js) args.push('--before', "const b=document.getElementById('body');" + js);
  if (process.argv[2] === 'shot') args.push('--screenshot', `.work/shot-${w}-${s}.png`);
  let r; for (let i=0;i<5 && !r;i++) { try { r = JSON.parse(execFileSync('node', args, {encoding:'utf8', stdio:['ignore','pipe','pipe']})); } catch {} }
  const v = r.value;
  out.push({w, s, ...v, linked: r.linkedCss[0].loaded, C1: v.gap===4 && Math.abs(v.rightDiff)<0.5, C2: v.sw<=v.iw && v.bsw<=v.iw});
}
console.log(JSON.stringify(out, null, 0).replace(/\},\{/g,'},\n{'));
EOF
