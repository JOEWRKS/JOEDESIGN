import fs from 'node:fs'; import zlib from 'node:zlib';
export function readPng(f){const b=fs.readFileSync(f);let p=8,w,h,ct,idat=[];while(p<b.length){const len=b.readUInt32BE(p),type=b.toString('ascii',p+4,p+8),d=b.subarray(p+8,p+8+len);if(type==='IHDR'){w=d.readUInt32BE(0);h=d.readUInt32BE(4);ct=d[9];if(d[8]!==8||d[12])throw 'fmt';}if(type==='IDAT')idat.push(d);p+=12+len;}
const bpp=ct===6?4:ct===2?3:(()=>{throw 'ct'+ct})();const raw=zlib.inflateSync(Buffer.concat(idat));const px=Buffer.alloc(w*h*bpp);const stride=w*bpp;
for(let y=0;y<h;y++){const f=raw[y*(stride+1)];const src=raw.subarray(y*(stride+1)+1,(y+1)*(stride+1));const cur=px.subarray(y*stride,(y+1)*stride);const prev=y?px.subarray((y-1)*stride,y*stride):null;
for(let x=0;x<stride;x++){const a=x>=bpp?cur[x-bpp]:0,up=prev?prev[x]:0,c=(prev&&x>=bpp)?prev[x-bpp]:0;let v=src[x];if(f===1)v+=a;else if(f===2)v+=up;else if(f===3)v+=(a+up)>>1;else if(f===4){const pp=a+up-c,pa=Math.abs(pp-a),pb=Math.abs(pp-up),pc=Math.abs(pp-c);v+=(pa<=pb&&pa<=pc)?a:(pb<=pc?up:c);}cur[x]=v&255;}}
return {w,h,get:(x,y)=>{const i=(y*w+x)*bpp;return [px[i],px[i+1],px[i+2]];}};}
EOF
cat > .work/spot.mjs <<'EOF'
import { readPng } from './png.mjs';
const [f, taR, taB] = [process.argv[2], +process.argv[3], +process.argv[4]];
const img = readPng(f); const dark = (x,y)=>{const [r,g,b]=img.get(x,y);return r+g+b < 700;};
// textarea bottom border: scan up from taB at column taR-20
let borderBottom=-1; for(let y=taB+2;y>taB-6;y--) if(dark(taR-20,y)){borderBottom=y;break;}
// textarea right border: scan at row taB-30
let borderRight=-1; for(let x=taR+2;x>taR-6;x--) if(dark(x,taB-30)){borderRight=x;break;}
// glyph pixels in band below textarea (rows taB+1..taB+30), cols 0..w
let gTop=1e9,gBottom=-1,gLeft=1e9,gRight=-1;
for(let y=borderBottom+1;y<taB+30;y++) for(let x=0;x<img.w;x++) if(dark(x,y)){gTop=Math.min(gTop,y);gBottom=Math.max(gBottom,y);gLeft=Math.min(gLeft,x);gRight=Math.max(gRight,x);}
// any content in last column of the capture
let lastCol=0; for(let y=0;y<img.h;y++) if(dark(img.w-1,y)) lastCol++;
let rightmost=-1; for(let x=img.w-1;x>=0 && rightmost<0;x--) for(let y=0;y<img.h;y++) if(dark(x,y)){rightmost=x;break;}
console.log(JSON.stringify({f, size:`${img.w}x${img.h}`, borderBottomRow:borderBottom, borderRightCol:borderRight, glyph:{top:gTop,bottom:gBottom,left:gLeft,right:gRight}, visibleGapPx: gTop-borderBottom-1, rightEdgeDiffPx: gRight-borderRight, darkPixelsInLastColumn:lastCol, rightmostContentCol:rightmost}));
EOF
