@@ -0,0 +1,29 @@
+// 캡처 PNG에서 요청 내용 칸 아래 테두리와 글자 수 글자(잉크)의 보이는 가장자리를 찾는다.
+// usage: node evidence/png-edges.mjs <png> <x0> <x1> <y0> <y1>
+import fs from 'node:fs';
+import zlib from 'node:zlib';
+const [file, x0, x1, y0, y1] = [process.argv[2], ...process.argv.slice(3).map(Number)];
+const buf = fs.readFileSync(file);
+let p = 8, w, h, bpp, idat = [];
+while (p < buf.length) {
+  const len = buf.readUInt32BE(p), type = buf.toString('ascii', p + 4, p + 8), d = buf.subarray(p + 8, p + 8 + len);
+  if (type === 'IHDR') { w = d.readUInt32BE(0); h = d.readUInt32BE(4); bpp = { 2: 3, 6: 4 }[d[9]]; }
+  if (type === 'IDAT') idat.push(d);
+  p += 12 + len;
+}
+const raw = zlib.inflateSync(Buffer.concat(idat)), stride = w * bpp, px = Buffer.alloc(h * stride);
+for (let y = 0; y < h; y++) {
+  const f = raw[y * (stride + 1)], src = raw.subarray(y * (stride + 1) + 1, (y + 1) * (stride + 1));
+  for (let i = 0; i < stride; i++) {
+    const a = i >= bpp ? px[y * stride + i - bpp] : 0, b = y ? px[(y - 1) * stride + i] : 0, c = y && i >= bpp ? px[(y - 1) * stride + i - bpp] : 0;
+    let v = src[i];
+    if (f === 1) v += a; else if (f === 2) v += b; else if (f === 3) v += (a + b) >> 1;
+    else if (f === 4) { const q = a + b - c, pa = Math.abs(q - a), pb = Math.abs(q - b), pc = Math.abs(q - c); v += pa <= pb && pa <= pc ? a : pb <= pc ? b : c; }
+    px[y * stride + i] = v & 255;
+  }
+}
+const dark = (x, y) => { const i = y * stride + x * bpp; return px[i] + px[i + 1] + px[i + 2] < 700; };
+const rows = [];
+for (let y = y0; y <= y1; y++) { let xs = []; for (let x = x0; x <= x1; x++) if (dark(x, y)) xs.push(x); if (xs.length) rows.push([y, xs.length, Math.min(...xs), Math.max(...xs)]); }
+let maxX = -1; for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) if (dark(x, y)) maxX = Math.max(maxX, x);
+console.log(JSON.stringify({ size: `${w}x${h}`, rowsNonWhite: rows, rightmostNonWhiteX: maxX }));
