diff --git a/src/char-count.js b/src/char-count.js
new file mode 100644
index 0000000..5f89997
--- /dev/null
+++ b/src/char-count.js
@@ -0,0 +1,10 @@
+// DEC-002: 요청 내용 칸 아래 오른쪽에 `현재 / 200` 글자 수, 입력할 때마다 갱신.
+(() => {
+  const body = document.getElementById('body');
+  const count = document.getElementById('body-count');
+  if (!body || !count) return;
+  const max = body.maxLength > 0 ? body.maxLength : 200;
+  const update = () => { count.textContent = `${body.value.length} / ${max}`; };
+  body.addEventListener('input', update);
+  update();
+})();
