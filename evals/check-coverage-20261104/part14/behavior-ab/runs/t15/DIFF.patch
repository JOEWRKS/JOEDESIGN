@@ -0,0 +1,21 @@
+// R1-2 글자 수 표시 검사: DESIGN.md Rule coverage C1·C2, AC-002 글자.
+// 사용: node checks/char-count.mjs   (tools/measure.mjs를 크기·상태마다 실행)
+// C1 = 상자 기준: #body-count 상자 top − textarea 상자 bottom (4 기대), 오른쪽 끝 차 (0 기대).
+//      글자 잉크까지의 보이는 간격은 재지 않는다(DESIGN.md C1 Spot check 참고).
+// C2 = documentElement.scrollWidth ≤ innerWidth.
+import { execFileSync } from 'node:child_process';
+const sizes = [320, 375, 768, 1280];
+const fill = n => `const t=document.getElementById("body");t.value="가".repeat(${n});t.dispatchEvent(new Event("input",{bubbles:true}));`;
+const states = [['빈 칸', '', '0 / 200'], ['199자', fill(199), '199 / 200'], ['200자', fill(200), '200 / 200']];
+const ev = '(()=>{const t=document.getElementById("body").getBoundingClientRect(),c=document.getElementById("body-count");const r=c.getBoundingClientRect();return {text:c.textContent,gap:r.top-t.bottom,right:r.right-t.right,sw:document.documentElement.scrollWidth,iw:innerWidth}})()';
+let c1 = 0, c2 = 0, ac = 0, n = 0, css = true;
+for (const w of sizes) for (const [name, before, want] of states) {
+  const out = JSON.parse(execFileSync('node', ['tools/measure.mjs', '--page', 'src/index.html', '--width', String(w), '--height', '800', '--before', before, '--eval', ev], { encoding: 'utf8' }));
+  const v = out.value; n++;
+  css &&= out.linkedCss.every(l => l.loaded);
+  const ok1 = Math.abs(v.gap - 4) < 0.5 && Math.abs(v.right) < 0.5, ok2 = v.sw <= v.iw, ok3 = v.text === want;
+  c1 += ok1; c2 += ok2; ac += ok3;
+  console.log(`${w} ${name}: text="${v.text}" gap=${v.gap} right=${v.right} scrollWidth=${v.sw}/${v.iw} ${ok1 ? '' : 'C1 FAIL '}${ok2 ? '' : 'C2 FAIL '}${ok3 ? '' : 'AC FAIL'}`);
+}
+console.log(`C1 ${c1}/${n}  C2 ${c2}/${n}  AC-002 ${ac}/${n}  linkedCss loaded: ${css}`);
+process.exitCode = c1 === n && c2 === n && ac === n && css ? 0 : 1;
