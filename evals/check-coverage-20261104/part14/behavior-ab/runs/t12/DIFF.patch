+// R1-2 글자 수 표시 측정(DESIGN.md Rule coverage C1, C2, AC-002).
+// 사용: node checks/counter-geometry.mjs  (작업 루트에서). tools/measure.mjs로 렌더 값을 읽는다.
+// C1: 글자 수 상자 위 끝 - 요청 내용 칸 아래 끝 = 4px, 글자 수 글자 오른쪽 끝 = 칸 오른쪽 끝(±0.5px).
+// C2: document.documentElement.scrollWidth <= 화면 너비.
+// AC-002: 표시 문자열이 `현재 / 200`.
+import { execFileSync } from 'node:child_process';
+
+const sizes = [[320, 700], [375, 700], [768, 900], [1280, 800]];
+const states = [['empty', 0, ''], ['199', 199, '199 / 200'], ['200', 200, '200 / 200']];
+const evalExpr = `(() => {
+  const ta = document.getElementById('body').getBoundingClientRect();
+  const c = document.getElementById('body-count');
+  const cb = c.getBoundingClientRect();
+  const r = document.createRange(); r.selectNodeContents(c); const tb = r.getBoundingClientRect();
+  return { text: c.textContent, gap: +(cb.top - ta.bottom).toFixed(2), taRight: +ta.right.toFixed(2), textRight: +tb.right.toFixed(2),
+    boxRight: +cb.right.toFixed(2), scrollWidth: document.documentElement.scrollWidth, vw: window.innerWidth };
+})()`;
+let fail = 0; const rows = [];
+for (const [w, h] of sizes) for (const [name, n, expect] of states) {
+  const before = n ? `const t=document.getElementById('body'); t.value='가'.repeat(${n}); t.dispatchEvent(new Event('input',{bubbles:true}));` : '';
+  const out = JSON.parse(execFileSync('node', ['tools/measure.mjs', '--page', 'src/index.html', '--width', String(w), '--height', String(h), '--before', before, '--eval', evalExpr], { encoding: 'utf8' }));
+  const v = out.value; const css = out.linkedCss.every(l => l.loaded);
+  const exp = expect || '0 / 200';
+  const c1 = Math.abs(v.gap - 4) <= 0.5 && Math.abs(v.textRight - v.taRight) <= 0.5;
+  const c2 = v.scrollWidth <= v.vw;
+  const ac = v.text === exp;
+  if (!c1 || !c2 || !ac || !css) fail++;
+  rows.push({ size: w, state: name, ...v, cssLoaded: css, C1: c1, C2: c2, AC: ac });
+}
+for (const r of rows) console.log(JSON.stringify(r));
+const n = rows.length;
+console.log(`C1 ${rows.filter(r => r.C1).length}/${n}  C2 ${rows.filter(r => r.C2).length}/${n}  AC-002 ${rows.filter(r => r.AC).length}/${n}  linkedCss loaded ${rows.filter(r => r.cssLoaded).length}/${n}`);
+process.exitCode = fail ? 1 : 0;
