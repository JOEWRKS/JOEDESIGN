@@ -0,0 +1,27 @@
+// R1-2 글자 수 표시 검사: DESIGN.md Rule coverage C1·C2, PRODUCT AC-002.
+// 사용: node checks/r1-2-char-count.mjs   (tools/measure.mjs를 크기·상태마다 호출, 페이지 자체 CSS 로드)
+import { execFileSync } from 'node:child_process';
+
+const sizes = [[320, 700], [375, 700], [768, 900], [1280, 800]];
+const states = { '빈 칸': 0, '199자': 199, '200자': 200 };
+const evalExpr = `(() => {
+  const ta = document.getElementById('body'), c = document.getElementById('body-count');
+  const t = ta.getBoundingClientRect(), b = c.getBoundingClientRect();
+  const r = document.createRange(); r.selectNodeContents(c); const g = r.getBoundingClientRect();
+  return { text: c.textContent, gapBox: b.top - t.bottom, gapText: g.top - t.bottom,
+    rightBox: b.right - t.right, rightText: g.right - t.right,
+    scrollWidth: document.documentElement.scrollWidth, innerWidth: window.innerWidth };
+})()`;
+const rows = [];
+for (const [w, h] of sizes) for (const [name, n] of Object.entries(states)) {
+  const before = `const ta=document.getElementById('body'); ta.focus(); ta.value='가나다라마 '.repeat(40).slice(0, ${n}); ta.dispatchEvent(new Event('input', {bubbles:true}));`;
+  const out = JSON.parse(execFileSync('node', ['tools/measure.mjs', '--page', 'src/index.html', '--width', String(w), '--height', String(h), '--before', before, '--eval', evalExpr], { encoding: 'utf8' }));
+  const v = out.value;
+  const r = { size: `${w}x${h}`, state: name, ...v, cssLoaded: out.linkedCss.every(l => l.loaded),
+    C1: Math.abs(v.gapBox - 4) < 0.5 && Math.abs(v.rightText) < 0.5,
+    C2: v.scrollWidth <= v.innerWidth,
+    AC: v.text === `${n} / 200` };
+  rows.push(r); console.log(JSON.stringify(r));
+}
+const sum = k => `${rows.filter(r => r[k]).length}/${rows.length}`;
+console.log(`C1 ${sum('C1')}  C2 ${sum('C2')}  AC-002 ${sum('AC')}  cssLoaded ${sum('cssLoaded')}`);
