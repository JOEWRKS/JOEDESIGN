import fs from 'node:fs'; import zlib from 'node:zlib';
function decode(f){const b=fs.readFileSync(f);let p=8,w,h,ct,idat=[];while(p<b.length){const len=b.readUInt32BE(p),type=b.toString('ascii',p+4,p+8),d=b.subarray(p+8,p+8+len);if(type==='IHDR'){w=d.readUInt32BE(0);h=d.readUInt32BE(4);ct=d[9];}if(type==='IDAT')idat.push(d);p+=12+len;}
const bpp=ct===6?4:3,raw=zlib.inflateSync(Buffer.concat(idat)),st=w*bpp,px=Buffer.alloc(h*st);
for(let y=0;y<h;y++){const ft=raw[y*(st+1)],src=raw.subarray(y*(st+1)+1,(y+1)*(st+1));for(let x=0;x<st;x++){const a=x>=bpp?px[y*st+x-bpp]:0,up=y?px[(y-1)*st+x]:0,c=(y&&x>=bpp)?px[(y-1)*st+x-bpp]:0;let v=src[x];if(ft===1)v+=a;else if(ft===2)v+=up;else if(ft===3)v+=(a+up)>>1;else if(ft===4){const pp=a+up-c,pa=Math.abs(pp-a),pb=Math.abs(pp-up),pc=Math.abs(pp-c);v+=pa<=pb&&pa<=pc?a:pb<=pc?up:c;}px[y*st+x]=v&255;}}
return {w,h,at:(x,y)=>[px[y*st+x*bpp],px[y*st+x*bpp+1],px[y*st+x*bpp+2]]};}
const [f,taB,taR,y0,y1]=process.argv.slice(2).map((v,i)=>i?+v:v);
const img=decode(f);const nonbg=(x,y)=>{const [r,g,b]=img.at(x,y);return r<245||g<245||b<245;};
// textarea visible bottom border: scan column x=taR-20 upward from taB+2
let border=null;for(let y=taB+2;y>taB-6;y--){if(nonbg(taR-20,y)){border=y;break;}}
// right border column at y = taB-20
let rb=null;for(let x=taR+2;x>taR-6;x--){if(nonbg(x,taB-20)){rb=x;break;}}
// ink of char count: rows y0..y1, x from 0..w
let top=null,bot=null,right=null,left=null;for(let y=y0;y<=y1;y++)for(let x=0;x<img.w;x++)if(nonbg(x,y)){top??=y;bot=y;right=Math.max(right??0,x);left=Math.min(left??1e9,x);}
let rightmost=-1;for(let y=0;y<img.h;y++)for(let x=img.w-1;x>rightmost;x--)if(nonbg(x,y)){rightmost=x;break;}
console.log(JSON.stringify({file:f,w:img.w,borderBottomRow:border,borderRightCol:rb,inkTop:top,inkBottom:bot,inkLeft:left,inkRight:right,visibleGapRows:top-border-1,rightEdgeDiff:right-rb,rightmostNonBgCol:rightmost}));
EOF
