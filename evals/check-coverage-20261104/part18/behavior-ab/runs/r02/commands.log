import { execFileSync } from 'node:child_process';
const pages = [['src/index.html','body','body-count'],['src/confirm.html','memo','memo-count']];
const sizes = [320,375,768,1280]; const states = {empty:0, full:200};
const out = [];
for (const [page, ta, cc] of pages) for (const w of sizes) for (const [st,n] of Object.entries(states)) {
  const before = `const t=document.getElementById('${ta}');t.value='가'.repeat(${n});t.dispatchEvent(new Event('input',{bubbles:true}));`;
  const ev = `(()=>{const t=document.getElementById('${ta}').getBoundingClientRect();const c=document.getElementById('${cc}').getBoundingClientRect();return {gap:+(c.top-t.bottom).toFixed(2),rightDiff:+(c.right-t.right).toFixed(2),text:document.getElementById('${cc}').textContent,sw:document.documentElement.scrollWidth,cw:document.documentElement.clientWidth,iw:innerWidth,taB:t.bottom,taR:t.right,ccT:c.top,ccR:c.right,ccH:c.height};})()`;
  const args = ['tools/measure.mjs','--page',page,'--width',String(w),'--height','800','--before',before,'--eval',ev];
  const mode = process.argv[2]||'own';
  if (mode==='inject' && page.includes('confirm')) args.push('--inject','src/style.css');
  if (process.argv[3]) args.push('--screenshot', `.work/${page.split('/')[1].replace('.html','')}-${w}-${st}-${mode}.png`);
  const r = JSON.parse(execFileSync('node', args, {encoding:'utf8'}));
  out.push({page,w,st,...r.value,linked:r.linkedCss.map(l=>l.loaded).join(),inj:r.injected});
}
for (const o of out) console.log(JSON.stringify(o));
EOF
