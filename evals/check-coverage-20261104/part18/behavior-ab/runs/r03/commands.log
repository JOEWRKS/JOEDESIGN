import fs from 'node:fs'; import zlib from 'node:zlib';
function png(f){const b=fs.readFileSync(f);let o=8,w,h,ct,idat=[];while(o<b.length){const l=b.readUInt32BE(o),t=b.toString('ascii',o+4,o+8),d=b.subarray(o+8,o+8+l);if(t==='IHDR'){w=d.readUInt32BE(0);h=d.readUInt32BE(4);ct=d[9];}if(t==='IDAT')idat.push(d);o+=12+l;}
const bpp=ct===6?4:3,raw=zlib.inflateSync(Buffer.concat(idat)),st=w*bpp,px=Buffer.alloc(h*st);
for(let y=0;y<h;y++){const ft=raw[y*(st+1)],s=raw.subarray(y*(st+1)+1,(y+1)*(st+1));for(let x=0;x<st;x++){const a=x>=bpp?px[y*st+x-bpp]:0,u=y?px[(y-1)*st+x]:0,c=(x>=bpp&&y)?px[(y-1)*st+x-bpp]:0;let v=s[x];if(ft===1)v+=a;else if(ft===2)v+=u;else if(ft===3)v+=(a+u)>>1;else if(ft===4){const p=a+u-c,pa=Math.abs(p-a),pb=Math.abs(p-u),pc=Math.abs(p-c);v+=(pa<=pb&&pa<=pc)?a:pb<=pc?u:c;}px[y*st+x]=v&255;}}
return {w,h,g:(x,y)=>[px[y*st+x*bpp],px[y*st+x*bpp+1],px[y*st+x*bpp+2]]};}
const [f,taR,taB]=[process.argv[2],+process.argv[3],+process.argv[4]];const im=png(f);
const nonwhite=(x,y)=>{const[r,g,b]=im.g(x,y);return r<245||g<245||b<245;};
// textarea visible bottom edge: last non-white row in column taR-40 scanning near taB
let edge=-1;for(let y=taB-6;y<taB+2;y++)if(nonwhite(taR-40,y))edge=y;
// glyph region: rows below edge+1 .. edge+30, columns taR-120..taR+10
let top=-1,right=-1;for(let y=edge+1;y<edge+30;y++)for(let x=taR-120;x<Math.min(im.w,taR+10);x++)if(nonwhite(x,y)){if(top<0)top=y;if(x>right)right=x;}
// textarea visible right edge on a row mid-box
let tRight=-1;const midY=taB-30;for(let x=taR-5;x<Math.min(im.w,taR+5);x++)if(nonwhite(x,midY))tRight=x;
console.log(JSON.stringify({file:f,boxBottomEdgeRow:edge,glyphTopRow:top,visibleGapPx:top-edge-1,boxRightEdgeCol:tRight,glyphRightCol:right,rightInsetPx:tRight-right,pageW:im.w}));
EOF
