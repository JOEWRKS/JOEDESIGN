[Bash] cd "<ROOT>" && cat > .work/run.mjs <<'EOF'
import { execFileSync } from 'node:child_process';
const pages = [
  { page: 'src/index.html', ta: 'body', cnt: 'body-count', inject: null },
  { page: 'src/confirm.html', ta: 'memo', cnt: 'memo-count', inject: 'src/style.css' },
];
const sizes = [320, 375, 768, 1280];
const states = { empty: '', full: '가'.repeat(200) };
const evalExpr = `(()=>{const t=document.getElementById(TA).getBoundingClientRect();const c=document.getElementById(CN).getBoundingClientRect();const d=document.documentElement;return {gap:+(c.top-t.bottom).toFixed(2),rightDiff:+(t.right-c.right).toFixed(2),text:document.getElementById(CN).textContent,len:document.getElementById(TA).value.length,sw:d.scrollWidth,cw:d.clientWidth,iw:innerWidth,bsw:document.body.scrollWidth,taR:t.right,cR:c.right,taB:t.bottom,cT:c.top,cH:c.height}})()`;
const out = [];
for (const p of pages) for (const w of sizes) for (const [s, v] of Object.entries(states)) {
  const before = v ? `const t=document.getElementById('${p.ta}');t.value=${JSON.stringify(v)};t.dispatchEvent(new Event('input',{bubbles:true}));` : '';
  const args = ['tools/measure.mjs', '--page', p.page, '--width', String(w), '--height', '800', '--eval', evalExpr.replace('TA', `'${p.ta}'`).replace(/TA/g, `'${p.ta}'`).replace(/CN/g, `'${p.cnt}'`)];
  if (before) args.push('--before', before);
  if (p.inject) args.push('--inject', p.inject);
  if (process.argv[2] === 'shot') args.push('--screenshot', `.work/${p.page.split('/')[1].replace('.html','')}-${w}-${s}.png`);
  const r = JSON.parse(execFileSync('node', args, { encoding: 'utf8' }));
  const v2 = r.value;
  const c1 = v2.gap === 4 && Math.abs(v2.rightDiff) < 0.5;
  const c2 = v2.sw <= v2.iw;
  out.push({ page: p.page, w, s, ...v2, css: r.linkedCss.map(l => l.loaded).join(','), injected: r.injected, c1, c2 });
  console.log(p.page, w, s, JSON.stringify(v2), 'css', r.linkedCss[0].loaded, 'inj', r.injected, 'C1', c1, 'C2', c2);
}
console.log('C1', out.filter(o => o.c1).length + '/' + out.length, 'C2', out.filter(o => o.c2).length + '/' + out.length);
EOF
