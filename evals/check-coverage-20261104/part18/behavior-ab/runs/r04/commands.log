#!/bin/sh
cd "$(dirname "$0")/.."
EVAL='(()=>{const ta=document.querySelector("textarea");const c=document.querySelector(".char-count");const f=ta.closest(".field");const a=ta.getBoundingClientRect(),b=c.getBoundingClientRect(),fr=f.getBoundingClientRect();const cs=getComputedStyle(ta);return {text:c.textContent,len:ta.value.length,gap:+(b.top-a.bottom).toFixed(2),rightDiff:+(b.right-a.right).toFixed(2),fieldRightDiff:+(b.right-fr.right).toFixed(2),taRight:a.right,taBottom:a.bottom,cTop:b.top,cRight:b.right,cH:b.height,sw:document.documentElement.scrollWidth,bsw:document.body.scrollWidth,iw:innerWidth,taBorder:cs.borderTopWidth,taPad:cs.paddingTop}})()'
FILL='const t=document.querySelector("textarea");t.value="가".repeat(200);t.dispatchEvent(new Event("input",{bubbles:true}));'
for p in index confirm; do
  INJ=""; [ $p = confirm ] && INJ="--inject src/style.css"
  for w in 320 375 768 1280; do
    for s in empty full; do
      B=""; [ $s = full ] && B="$FILL"
      echo "$p $w $s $(node tools/measure.mjs --page src/$p.html --width $w --height 800 $INJ --before "$B" --eval "$EVAL" --screenshot .work/$p-$w-$s.png)"
    done
  done
done
# confirm without inject, to show the linked-CSS state
echo "confirm-own 375 empty $(node tools/measure.mjs --page src/confirm.html --width 375 --height 800 --eval "$EVAL" --screenshot .work/confirm-own-375-empty.png)"
EOF
sh .work/run.sh > .work/results.txt 2>&1; cat .work/results.txt
