import fs from 'node:fs'; import zlib from 'node:zlib';
const [file, x0, x1, y0, y1] = process.argv.slice(2); const X0=+x0,X1=+x1,Y0=+y0,Y1=+y1;
const b = fs.readFileSync(file); let p = 8, w, h, ct, idat = [];
while (p < b.length) { const len = b.readUInt32BE(p), type = b.toString('ascii', p+4, p+8), d = b.subarray(p+8, p+8+len);
  if (type==='IHDR'){w=d.readUInt32BE(0);h=d.readUInt32BE(4);ct=d[9];} if(type==='IDAT')idat.push(d); p+=12+len; }
const raw = zlib.inflateSync(Buffer.concat(idat)); const bpp = ct===6?4:3, stride=w*bpp; const px=Buffer.alloc(h*stride);
for (let y=0;y<h;y++){const f=raw[y*(stride+1)];for(let x=0;x<stride;x++){const r=raw[y*(stride+1)+1+x];const a=x>=bpp?px[y*stride+x-bpp]:0;const u=y?px[(y-1)*stride+x]:0;const c=(x>=bpp&&y)?px[(y-1)*stride+x-bpp]:0;let v;
 switch(f){case 0:v=r;break;case 1:v=r+a;break;case 2:v=r+u;break;case 3:v=r+((a+u)>>1);break;case 4:{const q=a+u-c,pa=Math.abs(q-a),pb=Math.abs(q-u),pc=Math.abs(q-c);v=r+(pa<=pb&&pa<=pc?a:pb<=pc?u:c);}}px[y*stride+x]=v&255;}}
const at=(x,y)=>{const i=y*stride+x*bpp;return [px[i],px[i+1],px[i+2]];};
// textarea border: lowest row in x-range with non-white pixel above Y0
let borderBottom=-1, borderRight=-1;
for(let y=Y0-40;y<Y0;y++)for(let x=X0;x<=X1;x++){const [r,g,bb]=at(x,y);if(r<240||g<240||bb<240){borderBottom=Math.max(borderBottom,y);}}
const midY=Y0-30; for(let x=X1;x>=0;x--){const [r,g,bb]=at(x,midY);if(r<240||g<240||bb<240){borderRight=x;break;}}
let inkTop=1e9,inkBottom=-1,inkRight=-1;
for(let y=Y0;y<Y1;y++)for(let x=X0;x<=X1;x++){const [r,g,bb]=at(x,y);if(r<200||g<200||bb<200){inkTop=Math.min(inkTop,y);inkBottom=Math.max(inkBottom,y);inkRight=Math.max(inkRight,x);}}
console.log(JSON.stringify({w,h,borderBottomRow:borderBottom,borderRightCol:borderRight,inkTop,inkBottom,inkRight,visibleGap:inkTop-borderBottom-1,rightDiff:inkRight-borderRight}));
EOF
