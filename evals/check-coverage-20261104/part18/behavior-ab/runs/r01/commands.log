import fs from 'node:fs'; import zlib from 'node:zlib';
function decode(f){const b=fs.readFileSync(f);let p=8,w,h,ct,idat=[];while(p<b.length){const len=b.readUInt32BE(p);const type=b.toString('ascii',p+4,p+8);const d=b.subarray(p+8,p+8+len);if(type==='IHDR'){w=d.readUInt32BE(0);h=d.readUInt32BE(4);ct=d[9];}if(type==='IDAT')idat.push(d);p+=12+len;}
const bpp=ct===6?4:3;const raw=zlib.inflateSync(Buffer.concat(idat));const out=Buffer.alloc(w*h*bpp);const s=w*bpp;
for(let y=0;y<h;y++){const ft=raw[y*(s+1)];const line=raw.subarray(y*(s+1)+1,(y+1)*(s+1));for(let x=0;x<s;x++){const a=x>=bpp?out[y*s+x-bpp]:0,up=y?out[(y-1)*s+x]:0,c=(y&&x>=bpp)?out[(y-1)*s+x-bpp]:0;let v=line[x];if(ft===1)v+=a;else if(ft===2)v+=up;else if(ft===3)v+=(a+up)>>1;else if(ft===4){const pp=a+up-c,pa=Math.abs(pp-a),pb=Math.abs(pp-up),pc=Math.abs(pp-c);v+=(pa<=pb&&pa<=pc)?a:(pb<=pc?up:c);}out[y*s+x]=v&255;}}
return {w,h,px:(x,y)=>[out[(y*w+x)*bpp],out[(y*w+x)*bpp+1],out[(y*w+x)*bpp+2]]};}
const [f,taBottom,taRight]=process.argv.slice(2);const im=decode(f);const B=Math.round(+taBottom),R=Math.round(+taRight);
// textarea bottom border: last non-white row at column R-40 scanning around B
const col=R-40;let border=-1;for(let y=B-4;y<=B+1;y++){const [r,g,b]=im.px(col,y);if(r+g+b<720)border=y;}
// right border column at row B-20
let rb=-1;for(let x=R-4;x<=R+1;x++){const [r,g,b]=im.px(x,B-20);if(r+g+b<720)rb=x;}
// ink of count: below border, within x in [R-120,R+5], rows border+1 .. border+30, any non-white
let top=-1,right=-1;for(let y=border+1;y<border+30;y++)for(let x=R-120;x<R+5;x++){const [r,g,b]=im.px(x,y);if(r+g+b<700){if(top<0)top=y;if(x>right)right=x;}}
console.log(JSON.stringify({file:f,borderLastRow:border,rightBorderCol:rb,inkTop:top,inkRight:right,visibleGap:top-(border+1),inkRightVsBox:right-rb}));
EOF
