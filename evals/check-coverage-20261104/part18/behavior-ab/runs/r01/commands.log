import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
const pages = [
  { name: 'index', page: 'src/index.html', ta: 'body', cnt: 'body-count' },
  { name: 'confirm', page: 'src/confirm.html', ta: 'memo', cnt: 'memo-count' },
];
const widths = [320, 375, 768, 1280];
const states = { empty: '', full: "x".repeat(0) };
const mode = process.argv[2] || 'own'; // own | inject
const evalExpr = (ta, cnt) => `(()=>{const t=document.getElementById('${ta}').getBoundingClientRect();const c=document.getElementById('${cnt}');const r=c.getBoundingClientRect();const rg=document.createRange();rg.selectNodeContents(c);const g=rg.getBoundingClientRect();const cs=getComputedStyle(document.querySelector('.field'));return {text:c.textContent,taBottom:t.bottom,taRight:t.right,cTop:r.top,cRight:r.right,gap:+(r.top-t.bottom).toFixed(2),rightDiff:+(r.right-t.right).toFixed(2),glyphRight:+(g.right-t.right).toFixed(2),fieldGap:cs.rowGap,scrollWidth:document.documentElement.scrollWidth,clientWidth:document.documentElement.clientWidth,innerWidth:innerWidth,bodySW:document.body.scrollWidth,taLen:document.getElementById('${ta}').value.length}})()`;
const out = [];
for (const p of pages) for (const w of widths) for (const st of ['empty', '200']) {
  const before = st === 'empty' ? '' : `const el=document.getElementById('${p.ta}');el.value='가'.repeat(200);el.dispatchEvent(new Event('input',{bubbles:true}));`;
  const args = ['tools/measure.mjs', '--page', p.page, '--width', String(w), '--height', '800', '--eval', evalExpr(p.ta, p.cnt)];
  if (before) args.push('--before', before);
  if (mode === 'inject') args.push('--inject', 'src/style.css');
  if (process.argv[3] === 'shot') args.push('--screenshot', `.work/${mode}-${p.name}-${w}-${st}.png`);
  const res = JSON.parse(execFileSync('node', args, { encoding: 'utf8' }).trim());
  out.push({ page: p.name, w, st, ...res.value, linkedCss: res.linkedCss.map(l => l.loaded).join(','), injected: res.injected });
}
fs.writeFileSync(`.work/result-${mode}.json`, JSON.stringify(out, null, 1));
for (const o of out) console.log([o.page, o.w, o.st, o.text, 'gap', o.gap, 'right', o.rightDiff, 'glyphR', o.glyphRight, 'fieldGap', o.fieldGap, 'sw', o.scrollWidth, 'cw', o.clientWidth, 'css', o.linkedCss, o.injected].join(' '));
EOF
