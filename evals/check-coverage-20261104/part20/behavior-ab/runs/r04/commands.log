// Decode PNG capture; read visible edges of textarea border and count-text ink.
import fs from 'node:fs'; import zlib from 'node:zlib';
function decode(file){const b=fs.readFileSync(file);let p=8,w,h,ct,idat=[];while(p<b.length){const len=b.readUInt32BE(p),type=b.toString('ascii',p+4,p+8),d=b.subarray(p+8,p+8+len);if(type==='IHDR'){w=d.readUInt32BE(0);h=d.readUInt32BE(4);ct=d[9];}if(type==='IDAT')idat.push(d);p+=12+len;}
const bpp=ct===6?4:3,raw=zlib.inflateSync(Buffer.concat(idat)),stride=w*bpp,px=Buffer.alloc(h*stride);
for(let y=0;y<h;y++){const f=raw[y*(stride+1)],src=raw.subarray(y*(stride+1)+1,(y+1)*(stride+1));for(let x=0;x<stride;x++){const a=x>=bpp?px[y*stride+x-bpp]:0,up=y?px[(y-1)*stride+x]:0,c=y&&x>=bpp?px[(y-1)*stride+x-bpp]:0;let v=src[x];if(f===1)v+=a;else if(f===2)v+=up;else if(f===3)v+=(a+up)>>1;else if(f===4){const pp=a+up-c,pa=Math.abs(pp-a),pb=Math.abs(pp-up),pc=Math.abs(pp-c);v+=(pa<=pb&&pa<=pc)?a:(pb<=pc?up:c);}px[y*stride+x]=v&255;}}
return {w,h,get:(x,y)=>{const i=y*stride+x*bpp;return [px[i],px[i+1],px[i+2]];}};}
const nonWhite=([r,g,b])=>r<245||g<245||b<245, ink=([r,g,b])=>r<200&&g<200&&b<200;
const [file,taL,taB,taR]=process.argv.slice(2);const L=+taL,B=+taB,R=+taR;const im=decode(file);
// textarea bottom border: last non-white row scanning down column at mid of box near bottom
const mx=Math.round((L+R)/2);let border=-1;for(let y=B-6;y<B+3;y++) if(nonWhite(im.get(mx,y))) border=y;
// textarea right border: last non-white column on row B-30
let rborder=-1;for(let x=R-6;x<Math.min(im.w,R+3);x++) if(nonWhite(im.get(x,B-30))) rborder=x;
// count ink: region rows border+1..border+30, cols L..im.w
let top=1e9,right=-1,bottom=-1;for(let y=border+1;y<border+30;y++)for(let x=L;x<im.w;x++) if(ink(im.get(x,y))){top=Math.min(top,y);right=Math.max(right,x);bottom=Math.max(bottom,y);}
// rightmost painted column anywhere on page
let maxX=-1;for(let y=0;y<im.h;y++)for(let x=im.w-1;x>maxX;x--) if(nonWhite(im.get(x,y))){maxX=x;break;}
console.log(JSON.stringify({file,w:im.w,borderBottomRow:border,inkTopRow:top,visibleGap:top-border-1,borderRightCol:rborder,inkRightCol:right,rightInset:rborder-right,rightmostPainted:maxX}));
EOF
