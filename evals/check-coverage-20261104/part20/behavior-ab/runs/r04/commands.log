// C1/C2 measurement driver: calls tools/measure.mjs per page x size x state
import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
const pages = [
  { name: 'index', page: 'src/index.html', ta: '#body', cnt: '#body-count' },
  { name: 'confirm', page: 'src/confirm.html', ta: '#memo', cnt: '#memo-count' },
];
const sizes = [320, 375, 768, 1280];
const states = { empty: 0, n199: 199, n200: 200 };
const mode = process.argv[2] || 'own'; // own | inject
const out = [];
for (const p of pages) for (const w of sizes) for (const [st, n] of Object.entries(states)) {
  const before = n ? `const t=document.querySelector('${p.ta}'); t.value='가'.repeat(${n}); t.dispatchEvent(new Event('input',{bubbles:true}));` : '';
  const ev = `(()=>{const t=document.querySelector('${p.ta}').getBoundingClientRect();const c=document.querySelector('${p.cnt}');const r=c.getBoundingClientRect();return {ta:[t.left,t.top,t.right,t.bottom],cnt:[r.left,r.top,r.right,r.bottom],text:c.textContent,gap:r.top-t.bottom,rightDiff:t.right-r.right,sw:document.documentElement.scrollWidth,bsw:document.body.scrollWidth,iw:innerWidth,cw:document.documentElement.clientWidth,pad:getComputedStyle(document.querySelector('.page')).paddingLeft}})()`;
  const args = ['tools/measure.mjs', '--page', p.page, '--width', String(w), '--height', '900', '--eval', ev, '--screenshot', `.work/shots/${mode}-${p.name}-${w}-${st}.png`];
  if (before) args.push('--before', before);
  if (mode === 'inject') args.push('--inject', 'src/style.css');
  const res = JSON.parse(execFileSync('node', args, { encoding: 'utf8' }).trim());
  out.push({ page: p.name, w, st, ...res });
  console.log(p.name, w, st, JSON.stringify(res.value), JSON.stringify(res.linkedCss));
}
fs.writeFileSync(`.work/result-${mode}.json`, JSON.stringify(out, null, 1));
EOF
