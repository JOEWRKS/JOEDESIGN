import { execFileSync } from 'node:child_process'; import { decode } from './png.mjs';
const [page,id,w,state,inj]=process.argv.slice(2);
const before= state==='200'?`const t=document.getElementById('${id}'); t.value='가'.repeat(200); t.dispatchEvent(new Event('input'));`:'';
const shot=`.work/${id}-${w}-${state}${inj?'-inj':''}.png`;
const ev=`(()=>{const t=document.getElementById('${id}').getBoundingClientRect();const c=document.getElementById('${id}-count').getBoundingClientRect();return {t:[t.left,t.top,t.right,t.bottom],c:[c.left,c.top,c.right,c.bottom]}})()`;
const args=['tools/measure.mjs','--page',page,'--width',w,'--height','800','--eval',ev,'--screenshot',shot];
if(before) args.push('--before',before);
if(inj) args.push('--inject','src/style.css');
const r=JSON.parse(execFileSync('node',args,{encoding:'utf8'})).value;
const im=decode(shot);const W=+w;
const nw=([a,b,c])=>a<240||b<240||c<240;
const [tl,tt,tr,tb]=r.t.map(Math.round);
// border bottom row: scan at x=tr-3 from tb-10 down
let borderBottom=-1;for(let y=tb-6;y<tb+3;y++) if(nw(im.get(tr-3,y))) borderBottom=y;
let borderRight=-1;const ym=Math.round((tt+tb)/2);for(let x=tr-6;x<tr+3;x++) if(nw(im.get(x,ym))) borderRight=x;
// ink bbox of count: rows borderBottom+1 .. +30, cols tl..W-1
let minY=1e9,maxY=-1,minX=1e9,maxX=-1;for(let y=borderBottom+1;y<borderBottom+30;y++)for(let x=tl;x<W;x++) if(nw(im.get(x,y))){minY=Math.min(minY,y);maxY=Math.max(maxY,y);minX=Math.min(minX,x);maxX=Math.max(maxX,x);}
console.log(JSON.stringify({page,w,state,inj:!!inj,box:r,borderBottomRow:borderBottom,borderRightCol:borderRight,ink:{minX,maxX,minY,maxY},visibleGapPx:minY-borderBottom-1,rightDiffPx:borderRight-maxX}));
EOF
