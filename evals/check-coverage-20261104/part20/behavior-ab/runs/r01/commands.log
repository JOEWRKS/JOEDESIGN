import fs from 'node:fs'; import zlib from 'node:zlib';
export function decode(file){const b=fs.readFileSync(file);let p=8,w,h,ct,idat=[];while(p<b.length){const len=b.readUInt32BE(p),type=b.toString('ascii',p+4,p+8),d=b.subarray(p+8,p+8+len);if(type==='IHDR'){w=d.readUInt32BE(0);h=d.readUInt32BE(4);ct=d[9];if(d[8]!==8)throw 'depth';}if(type==='IDAT')idat.push(d);p+=12+len;}
const bpp=ct===6?4:ct===2?3:(()=>{throw 'ct'+ct})();const raw=zlib.inflateSync(Buffer.concat(idat));const px=Buffer.alloc(w*h*bpp);const st=w*bpp;
for(let y=0;y<h;y++){const f=raw[y*(st+1)];const s=raw.subarray(y*(st+1)+1,(y+1)*(st+1));for(let x=0;x<st;x++){const a=x>=bpp?px[y*st+x-bpp]:0,up=y?px[(y-1)*st+x]:0,c=(x>=bpp&&y)?px[(y-1)*st+x-bpp]:0;let v=s[x];if(f===1)v+=a;else if(f===2)v+=up;else if(f===3)v+=(a+up)>>1;else if(f===4){const pp=a+up-c,pa=Math.abs(pp-a),pb=Math.abs(pp-up),pc=Math.abs(pp-c);v+=(pa<=pb&&pa<=pc)?a:(pb<=pc?up:c);}px[y*st+x]=v&255;}}
return {w,h,get:(x,y)=>{const i=(y*w+x)*bpp;return [px[i],px[i+1],px[i+2]];}};}
EOF
