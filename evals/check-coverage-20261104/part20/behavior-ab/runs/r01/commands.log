import { execFileSync } from 'node:child_process';
const pages = [['src/index.html','body'],['src/confirm.html','memo']];
const widths = [320,375,768,1280];
const out = [];
for (const [page,id] of pages) for (const w of widths) for (const state of ['empty','200']) for (const inj of (page.includes('confirm')?[false,true]:[false])) {
  const before = state==='200' ? `const t=document.getElementById('${id}'); t.value='가'.repeat(200); t.dispatchEvent(new Event('input'));` : '';
  const ev = `(()=>{const t=document.getElementById('${id}').getBoundingClientRect();const c=document.getElementById('${id}-count').getBoundingClientRect();return {gap:+(c.top-t.bottom).toFixed(2),right:+(t.right-c.right).toFixed(2),text:document.getElementById('${id}-count').textContent,len:document.getElementById('${id}').value.length,sw:document.documentElement.scrollWidth,iw:innerWidth,t:[t.left,t.top,t.right,t.bottom],c:[c.left,c.top,c.right,c.bottom]}})()`;
  const args = ['tools/measure.mjs','--page',page,'--width',String(w),'--height','800','--eval',ev];
  if (before) args.push('--before',before);
  if (inj) args.push('--inject','src/style.css');
  const r = JSON.parse(execFileSync('node',args,{encoding:'utf8'}));
  out.push({page,w,state,inj,...r.value,css:r.linkedCss.map(l=>l.loaded).join()});
}
for (const o of out) console.log(JSON.stringify(o));
EOF
